# COOLEMS "Jack" - Version Control Exclusions
# Repo root = THIS folder (local_ai/). All paths below are relative to it.

# NOTE (2026-09-23): the internet relay is now a SINGLE FILE: web_server_relay/index.php
# (pure-PHP WebSocket relay, protocol v4). It ships with real keys pre-filled in its
# CONFIG block, so it stays OUT of git - deploy it by copying the file to your host.

# Tests: kept only on the development PC for now (2026-09-12). Excluded so they don't
# get pushed; to open them up again in the future, remove this line and run `git add tests`.
tests/

# API keys / credentials (NEVER commit)
config/.api_keys.json

# The single-file PHP relay ships with real keys in its CONFIG block -> never commit.
web_server_relay/index.php

    # zzz_manage_server_relay.py IS tracked (no secrets inside - it reads the admin key
    # from config/.api_keys.json at runtime on the home machine).

# Self-signed relay certs generated by `php index.php --make-selfsigned` (also caught
# by the *.crt / *.key rules below, listed here for clarity).
web_server_relay/relay-selfsigned.crt
web_server_relay/relay-selfsigned.key

# Real profiles: machine-specific model paths (auto-recreated at runtime from the
# shipped <name>.example.json templates - see config/bootstrap.py). Examples stay tracked.
config/profiles.json

# Llama server instance list (2026-09-08 multi-chat): hand-edited per-machine SoT for which
# llama servers the SERVER creates at boot (see config.get_llama_server_instances()). Seeded
# from the shipped template on first boot - never overwrite; the example stays tracked.
config/llama_servers.json
# CLIENT's copy of its SERVER credentials
CLIENT/config/.api_client_keys.json

# CLIENT user settings & working-root state (per-machine, auto-created at runtime)
CLIENT/config/settings.json
CLIENT/config/.working_root.json

# Last-loaded model state (per-machine runtime data written by the SERVER after every
# verified launch/switch - see app/providers/llama/model_persistence.py). Source of
# truth for which model to load on next startup; never commit.
config/.last_model_loaded.json

# Python artifacts
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# CLIENT-side tool runtimes (2026-09-11): NEVER commit.
CLIENT/tools/runtimes/

# OS files
.DS_Store
Thumbs.db

# Logs & databases (*.db-wal / *.db-shm are SQLite sidecars of chat_history.db)
logs/
*.db
*.db-wal
*.db-shm
*.log

# IDE
.idea/
.vscode/

# Backups (never commit)
*.backup

# Working plan files (per-session scratch notes, never commit)
plan_*.md

# Certificates / private keys (NEVER commit) - also covers config/coolems_direct_ws_cert.pem
# and config/coolems_direct_ws_key.pem via the *.pem rule below.
# Only the how-to readme inside certs/ is kept; every actual certificate/key file stays out.
certs/*
!certs/_readme_how_to_install_cerificates.txt
*.crt
*.pem
*.key
*.p12
*.pfx

# llama_server: ignore everything EXCEPT the download documentation file and the
# models folder tree. The folder is filled with large pre-built binaries (~1.3 GB of
# DLLs/exes from a llama.cpp Windows CUDA release) - see "download llama_server files.md"
# inside it for where to get them and how to lay them out on disk.
llama_server/*
!llama_server/download llama_server files.md
!llama_server/models/

# llama_server/models: ignore EVERYTHING inside (model weights, projectors, temp
# downloads...) at every level EXCEPT readme files.
# NOTE: git cannot re-include a file whose parent directory is ignored, so the
# subdirectories are explicitly kept open per level. Covers models/<name>/... one
# level deep (the layout used by path_utils._get_default_models_dir()).
llama_server/models/*
!llama_server/models/[Rr][Ee][Aa][Dd][Mm][Ee].md
!llama_server/models/[Rr][Ee][Aa][Dd][Mm][Ee].txt
!llama_server/models/*/
llama_server/models/*/*
!llama_server/models/*/[Rr][Ee][Aa][Dd][Mm][Ee].md
!llama_server/models/*/[Rr][Ee][Aa][Dd][Mm][Ee].txt

# python_exec scratch space (2026-09-18): every temp file created by executed
# code lands here -- the folder itself stays tracked via .gitkeep, its contents never.
.temp/*
!.temp/.gitkeep
